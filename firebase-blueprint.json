{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Store products",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 200 },
        "originalPrice": { "type": "number" },
        "discountedPrice": { "type": "number" },
        "buyingPrice": { "type": "number" },
        "image": { "type": "string" },
        "category": { "type": "string" },
        "isNew": { "type": "boolean" },
        "isFlashSale": { "type": "boolean" },
        "rating": { "type": "number" },
        "reviews": { "type": "number" },
        "weight": { "type": "string" },
        "description": { "type": "string" },
        "stock": { "type": "number" },
        "lowStockAlert": { "type": "number" }
      },
      "required": ["id", "name", "originalPrice", "image", "category"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer order",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerName": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 20 },
        "address": { "type": "string", "maxLength": 500 },
        "items": {
          "type": "array",
          "maxLength": 100
        },
        "total": { "type": "number" },
        "date": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["Pending", "Confirmed", "Shipped", "Completed", "Cancelled"]
        },
        "source": { "type": "string" }
      },
      "required": ["id", "customerName", "phone", "address", "total", "date", "status"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Saved customer info",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 20 },
        "address": { "type": "string", "maxLength": 500 }
      },
      "required": ["id", "phone"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Income and expense transactions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "amount": { "type": "number" },
        "date": { "type": "string" },
        "type": { "type": "string", "enum": ["income", "expense"] },
        "category": { "type": "string" },
        "note": { "type": "string" },
        "isAutomated": { "type": "boolean" }
      },
      "required": ["id", "amount", "date", "type", "category"]
    },
    "Due": {
      "title": "Due",
      "description": "Customer dues",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerName": { "type": "string" },
        "phone": { "type": "string" },
        "amount": { "type": "number" },
        "paidAmount": { "type": "number" },
        "dueDate": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "amount", "paidAmount"]
    },
    "AppNotification": {
      "title": "Notification",
      "description": "System or order notification",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "timestamp": { "type": "string" },
        "read": { "type": "boolean" },
        "type": { "type": "string", "enum": ["order", "system"] }
      },
      "required": ["id", "title", "message", "timestamp", "read", "type"]
    }
  },
  "firestore": {
    "products/{productId}": {
      "schema": "Product",
      "description": "Product catalog"
    },
    "orders/{orderId}": {
      "schema": "Order",
      "description": "Customer orders"
    },
    "customers/{customerId}": {
      "schema": "Customer",
      "description": "Customer address book"
    },
    "transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Financial transactions"
    },
    "dues/{dueId}": {
      "schema": "Due",
      "description": "Customer dues"
    },
    "notifications/{notificationId}": {
      "schema": "AppNotification",
      "description": "System notifications"
    }
  }
}
